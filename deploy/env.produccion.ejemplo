# Variables de entorno de BioMicro en el servidor de la UTC.
# Copiar a /opt/biomicro/app/.env, completar y dejar con permisos 600:
#   sudo -u biomicro cp deploy/env.produccion.ejemplo .env
#   sudo chmod 600 /opt/biomicro/app/.env
# settings.py lo carga con python-dotenv. Sin comillas en los valores.

# --- Django ---------------------------------------------------------------
# Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=False

# Dominio(s) que asigne TI, separados por coma, sin https://
ALLOWED_HOSTS=biomicro.utc.edu.ec
# Los mismos dominios, CON https://
CSRF_TRUSTED_ORIGINS=https://biomicro.utc.edu.ec

# --- HTTPS ----------------------------------------------------------------
# Nginx termina el TLS y avisa a Django con X-Forwarded-Proto.
SECURE_SSL_REDIRECT=True
# Empezar con 3600 (1 hora). Cuando todo funcione con HTTPS, subir a
# 31536000 (1 año): el navegador recuerda HSTS y no deja volver a http.
SECURE_HSTS_SECONDS=3600

# Cantidad de proxys delante de Gunicorn. Solo Nginx = 1.
# Si TI pone otro proxy/balanceador delante de Nginx = 2.
ALLAUTH_TRUSTED_PROXY_COUNT=1

# --- Base de datos ----------------------------------------------------------
# postgresql://USUARIO:CONTRASEÑA@HOST:5432/NOMBRE_BD
DATABASE_URL=

# --- Correo -----------------------------------------------------------------
# Correo institucional de la UTC: servidor, puerto y cuenta los entrega TI.
# Si la UTC usa Microsoft 365: smtp.office365.com / 587.
# Si usa Google Workspace:     smtp.gmail.com / 587 + contraseña de aplicación.
EMAIL_HOST=
EMAIL_PORT=587
# Puerto 587 -> EMAIL_USE_TLS=True, EMAIL_USE_SSL=False
# Puerto 465 -> EMAIL_USE_TLS=False, EMAIL_USE_SSL=True
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=biomicro@utc.edu.ec
EMAIL_HOST_PASSWORD=
# Nombre y dirección que ven los usuarios en los correos.
DEFAULT_FROM_EMAIL=BioMicro UTC <biomicro@utc.edu.ec>

# --- Inicio de sesión con Google (opcional) ---------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
