# ============================================================
# TerraBioLab UTC — Variables de Entorno
# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" al repositorio.
# ============================================================

# ----------------------------------------------------------
# SEGURIDAD
# ----------------------------------------------------------
# Genera una clave segura con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-cambia-esto-en-produccion

# En producción usar False
DEBUG=True

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=127.0.0.1,localhost

# Con DEBUG=False se activan automáticamente HSTS, cookies "secure" y
# redirección forzada a HTTPS (ver config/settings.py). Solo tocar estas
# dos si el servidor NO está detrás de HTTPS todavía:
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# ----------------------------------------------------------
# BASE DE DATOS (PostgreSQL)
# ----------------------------------------------------------
DB_NAME=Proyect
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_HOST=localhost
DB_PORT=5432

# ----------------------------------------------------------
# AUTENTICACIÓN SOCIAL (Google OAuth) — Opcional
# Crear credenciales en: https://console.cloud.google.com/
# ----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------
# EMAIL (para recuperación de contraseña) — Opcional
# ----------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TerraBioLab UTC <no-reply@terrabiolab.edu.ec>

# ----------------------------------------------------------
# ARCHIVOS ESTÁTICOS Y MEDIA
# ----------------------------------------------------------
# En producción, configurar STATIC_ROOT y servir con nginx/whitenoise
STATIC_URL=/static/
MEDIA_URL=/media/
